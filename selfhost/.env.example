# ---------- Express Tech Design Center settings ----------
# Copy this file to .env and fill it in:   cp .env.example .env

# The public web address people open (used for secure cookies, the Claude connector and Zoho's return address).
APP_URL=https://design.expresskw.com
# With docker-compose.yml (own Caddy): the domain Caddy gets the HTTPS certificate for
DOMAIN=design.expresskw.com
# With docker-compose.with-leadzin.yml: LeadzIN's Docker network (docker network ls)
# PROXY_NETWORK=leadzin_default

# First admin — created automatically on the very first start (when there are no logins yet).
# A new password is asked at the first sign-in. You can delete these lines afterwards.
ADMIN_NAME=Husain Kazi
ADMIN_USERNAME=husain
ADMIN_EMAIL=
ADMIN_PASSWORD=change-me-at-first-sign-in

COMPANY_NAME=Express Tech

# Stay signed in for this many days (phones on site stay signed in)
SESSION_DAYS=60
# Largest floor drawing (PDF) the planner may upload, in MB
MAX_UPLOAD_MB=60
# Nightly database backup: hour (server time, 0-23) and how many to keep
BACKUP_HOUR=2
BACKUP_KEEP=7

# ---------- integrations (optional here) ----------
# Easiest: leave these empty and set them up in Admin → Integrations. If filled in, they are copied there on the first start.
ASANA_TOKEN=
ZOHO_DC=com
ZOHO_ORG_ID=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_TEMPLATE_ID=
ZOHO_SALESPERSON=

# ---------- advanced ----------
# SECRET_KEY=long-random-text   # encrypts integration keys; if empty, data/secret.key is made (it is backed up with data/)
# ASANA_CRON_SECONDS=120         # how often linked Asana projects are mirrored
# VAPID_SUBJECT=mailto:it@expresskw.com
# TRUST_PROXY=true               # true behind Caddy (reads the real address of whoever signs in)
# TRUST_CLOUDFLARE=false         # true only if the site is reached through a Cloudflare tunnel (CF-Connecting-IP)
# COOKIE_SECURE=true             # defaults to true when APP_URL starts with https://
# PORT=3000
# DATA_DIR=./data
